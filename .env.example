# Copy to .env and fill in every value. Never commit .env.
# Generate passwords and SECRET_KEY with:  openssl rand -hex 32
# (hex, not base64: base64 output can contain "/", "+" and "=", which break the
#  postgresql://user:password@host URLs that docker-compose.yml builds from these values)
# CREDENTIALS_ENCRYPTION_KEY is different; see its comment below.

# --- Network ---
# 127.0.0.1 = reachable only from this machine (dev, or behind a reverse proxy).
# Set to 0.0.0.0 only on a firewalled LAN pilot without a proxy.
BIND_ADDR=127.0.0.1
API_PORT=8100
DASHBOARD_PORT=8501
PUBLIC_BASE_URL=https://visionguard.example.com

# --- Backend ---
SECRET_KEY=
# Key for encrypting camera credentials at rest (Fernet, 32-byte urlsafe base64)
CREDENTIALS_ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
DEFAULT_TIMEZONE=Africa/Kigali

# --- PostgreSQL ---
POSTGRES_DB=visionguard
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=

# --- MQTT (create users with: mosquitto_passwd, see 13-installation-guide.md) ---
MQTT_USER=visionguard_backend
MQTT_PASSWORD=
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=

# --- Cameras (Frigate substitutes FRIGATE_* variables into frigate/config.yml) ---
# Frigate receives only the FRIGATE_* variables listed under "frigate: environment:"
# in docker-compose.yml. A new one must be added there too.
FRIGATE_RTSP_USER=
FRIGATE_RTSP_PASSWORD=
FRIGATE_ENTRANCE_HOST=192.168.1.10
FRIGATE_DINING_HOST=192.168.1.11
FRIGATE_PITCH_HOST=192.168.1.12

# --- Storage ---
# local = Docker volume (default, MVP). s3 = any S3-compatible store (SeaweedFS, Garage, AWS, Wasabi...)
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@visionguard.example.com

# --- Label Studio (profile: labeling) ---
LABEL_STUDIO_HOST=http://localhost:8080
LABEL_STUDIO_USERNAME=
LABEL_STUDIO_PASSWORD=
